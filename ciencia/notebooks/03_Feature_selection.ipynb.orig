   "source": [
    "# Inicializa ExtraTrees para ranking de features\n",
    "clf = ExtraTreesClassifier(\n",
    "    n_estimators=500,\n",
    "    max_depth=None,\n",
    "    min_samples_leaf=10,\n",
    "    random_state=RANDOM_STATE,\n",
    "    n_jobs=-1\n",
    ")\n",
    "\n",
    "# Treina o modelo\n",
    "clf.fit(X_train, y_train)\n",
    "\n",
    "# Importância padrão do ExtraTrees\n",
    "feat_imp = pd.DataFrame({\n",
    "    \"feature\": X_train.columns,\n",
    "    \"importance\": clf.feature_importances_\n",
    "}).sort_values(by=\"importance\", ascending=False)"
   ]
  },
  {
   "cell_type": "raw",
   "id": "c40ef780-4d39-48c8-a379-395217f35819",
   "metadata": {
    "vscode": {
     "languageId": "raw"
    }
   },
   "source": [
    "# Permutation importance (mais confiável)\n",
    "perm_res = permutation_importance(\n",
    "    clf, X_train, y_train, n_repeats=10, random_state=RANDOM_STATE, n_jobs=-1\n",
    ")\n",
    "\n",
    "perm_imp = pd.DataFrame({\n",
    "    \"feature\": X_train.columns,\n",
    "    \"perm_importance\": perm_res.importances_mean\n",
    "}).sort_values(by=\"perm_importance\", ascending=False)\n",
    "\n",
    "# Combina rankings\n",
    "combined = feat_imp.merge(perm_imp, on=\"feature\")\n",
    "combined[\"rank_score\"] = combined[\"importance\"].rank(ascending=False) + combined[\"perm_importance\"].rank(ascending=False)\n",
    "combined = combined.sort_values(by=\"rank_score\")\n",
    "\n",
    "# Seleciona top N features combinadas\n",
    "selected_features_fs = combined.head(TOP_N_FEATURES)[\"feature\"].tolist()\n",
    "\n",
    "print(f\"Número de features selecionadas: {len(selected_features_fs)}\")\n",
    "print(\"Top features:\", selected_features_fs)"
   ]
  },
