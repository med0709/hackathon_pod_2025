   "cell_type": "markdown",
<<<<<<< HEAD
   "id": "c7458c06",
   "metadata": {},
   "source": [
    "## Preparando os dados de Teste"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 178,
   "id": "df5a3553",
   "metadata": {},
   "outputs": [],
   "source": [
    "# função para padronizar tratamento inicial e engenharia básica de features\n",
    "def preprocess_base(df):\n",
    "    df = df.copy()\n",
    "\n",
    "    # tipagem\n",
    "    df['CEP_3_digitos'] = df['CEP_3_digitos'].astype('Int64')\n",
    "    df['DATADENASCIMENTO'] = pd.to_datetime(df['DATADENASCIMENTO'], format='%d/%m/%Y', errors='coerce')\n",
    "\n",
    "    # datas auxiliares\n",
    "    df['SAFRA_DT'] = pd.to_datetime(df['SAFRA'].astype(str) + '01', format='%Y%m%d', errors='coerce')\n",
    "\n",
    "    # idade na safra\n",
    "    df['IDADE'] = ((df['SAFRA_DT'] - df['DATADENASCIMENTO']).dt.days // 365)\n",
    "\n",
    "    # colunas a remover\n",
    "    ignore_cols = ['SAFRA', 'FPD', 'FPD_bureau', 'FPD_telco', 'flag_mig2', 'flag_mig2_bureau', 'flag_mig2_telco', 'NUM_CPF', 'DATADENASCIMENTO', 'SAFRA_DT']\n",
    "\n",
    "    df = df.drop(columns=ignore_cols, errors='ignore')\n",
    "\n",
    "    return df"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 179,
   "id": "7d11c362",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Backup dos dados originais\n",
    "abt01_test = df_test.copy()\n",
    "\n",
    "abt01_test  = preprocess_base(abt01_test)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 180,
   "id": "454878e0",
   "metadata": {},
   "outputs": [],
   "source": [
    "# carregar colunas a remover\n",
    "with open(Path(ARTIFACT_DIR) / 'var_drop.pkl', 'rb') as f:\n",
    "    var_drop = pickle.load(f)\n",
    "\n",
    "# aplicar no conjunto de teste\n",
    "abt01_test = abt01_test.drop(columns=var_drop, errors='ignore')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 181,
   "id": "bb734b55",
   "metadata": {},
   "outputs": [],
   "source": [
    "# carregar estatísticas de imputação\n",
    "with open(Path(ARTIFACT_DIR) / 'stats_nulo.pkl', 'rb') as f:\n",
    "    stats = pickle.load(f)\n",
    "\n",
    "# numéricas\n",
    "for col, value in stats['numerical'].items():\n",
    "    if col in abt01_test.columns:\n",
    "        abt01_test[col] = abt01_test[col].fillna(value)\n",
    "\n",
    "# categóricas\n",
    "cat_cols = abt01_test.select_dtypes(include=['object']).columns\n",
    "abt01_test[cat_cols] = abt01_test[cat_cols].fillna(stats['categorical_fill'])\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 182,
   "id": "fc134dab",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Colunas ainda com string: ['var_03', 'var_04', 'var_05', 'var_09', 'var_24', 'var_25', 'REGIAO_POSTAL', 'SUB_REGIAO_POSTAL', 'REGIAO_POSTAL_TXT']\n"
     ]
    }
   ],
   "source": [
    "# Verifica se ainda sobrou alguma coluna string após o encoding\n",
    "cols_string = abt01_test.select_dtypes(include=['object', 'category']).columns.tolist()\n",
    "print(\"Colunas ainda com string:\", cols_string)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 183,
   "id": "d027b89d",
   "metadata": {},
   "outputs": [],
   "source": [
    "# carregar encoders e aplicar encoding na base de teste\n",
    "artifact_path_lenc = Path(ARTIFACT_DIR) / 'data_lenc.pkl'\n",
    "artifact_path_onehot = Path(ARTIFACT_DIR) / 'data_onehot.pkl'\n",
    "\n",
    "# load artefatos\n",
    "with open(artifact_path_lenc, 'rb') as f:\n",
    "    data_lenc = pickle.load(f)\n",
    "\n",
    "with open(artifact_path_onehot, 'rb') as f:\n",
    "    data_onehot = pickle.load(f)\n",
    "\n",
    "# ---------------- LabelEncoder ----------------\n",
    "encoders = data_lenc[\"encoders\"]\n",
    "columns_lenc = data_lenc[\"columns\"]\n",
    "\n",
    "for col in columns_lenc:\n",
    "    if col in abt01_test.columns:\n",
    "        mapping = {label: idx for idx, label in enumerate(encoders[col].classes_)}\n",
    "        abt01_test[col] = abt01_test[col].map(mapping).fillna(-1).astype(int)\n",
    "\n",
    "# ---------------- OneHotEncoder ----------------\n",
    "onehot_encoder = data_onehot[\"encoder\"]\n",
    "onehot_cols = data_onehot[\"input_columns\"]\n",
    "output_cols = data_onehot[\"output_columns\"]\n",
    "\n",
    "X_onehot = onehot_encoder.transform(abt01_test[onehot_cols])\n",
    "\n",
    "df_onehot = pd.DataFrame(\n",
    "    X_onehot,\n",
    "    columns=output_cols,\n",
    "    index=abt01_test.index\n",
    ")\n",
    "\n",
    "# remove colunas originais e concatena onehot\n",
    "abt01_test = pd.concat(\n",
    "    [abt01_test.drop(onehot_cols, axis=1), df_onehot],\n",
    "    axis=1\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "4292da55",
   "metadata": {},
   "source": [
