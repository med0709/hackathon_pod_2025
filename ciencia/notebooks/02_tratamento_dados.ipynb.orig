  {
   "cell_type": "markdown",
   "id": "0cf5271b",
   "metadata": {},
   "source": [
    "## Nomarlização"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 191,
   "id": "355ec91f",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Escala numérica: normalização ou padronização =====\n",
    "if ESCALA_NUMERICA == \"padronizacao\":\n",
    "    scaler_num = StandardScaler()\n",
    "elif ESCALA_NUMERICA == \"normalizacao\":\n",
    "    scaler_num = MinMaxScaler()\n",
    "else:\n",
    "    raise ValueError(\"ESCALA_NUMERICA deve ser 'padronizacao' ou 'normalizacao'\")\n",
    "\n",
    "# Instanciando o scaler\n",
    "scaler = scaler_num\n",
    "\n",
    "# Selecionando colunas numéricas\n",
    "numeric_cols = abt01.select_dtypes(include=['float64', 'int64','int32']).columns\n",
    "\n",
    "# Aplicando a normalização\n",
    "abt01[numeric_cols] = scaler.fit_transform(abt01[numeric_cols])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 192,
   "id": "ec0dedcc",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Salva o scaler em um arquivo .pkl\n",
    "artifact_path = Path(ARTIFACT_DIR) / 'scaler.pkl'\n",
    "\n",
    "with open(artifact_path, 'wb') as f:\n",
    "    pickle.dump(scaler, f)"
   ]
  },
