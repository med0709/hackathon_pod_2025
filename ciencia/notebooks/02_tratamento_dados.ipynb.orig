    "cols_train = set(abt01.columns)\n",
    "cols_test = set(abt01_test.columns)\n",
    "\n",
    "print('Só no treino:', cols_train - cols_test)\n",
    "print('Só no teste:', cols_test - cols_train)"
   ]
